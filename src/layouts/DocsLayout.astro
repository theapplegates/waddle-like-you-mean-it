---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
// Components
import Sidebar from "@/components/global/navigation/Sidebar.astro";
import MobileTopBar from "@/components/global/navigation/MobileTopBar.astro";
import DesktopTopBar from "@/components/global/navigation/DesktopTopBar.astro";
---

<BaseLayout hideNav={true} hideFooter={true}>
  <div class="min-h-screen">
    <!-- Mobile header -->
    <MobileTopBar />
    <div class="flex">
      <!-- Sidebar -->
      <Sidebar />
      <!-- Main content -->
      <main class="flex-1 min-w-0 lg:pl-72">
        <!-- Desktop header -->
        <DesktopTopBar />
        <!-- Content -->
        <div class="py-4 lg:py-14">
          <article>
            <slot />
          </article>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>
