---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
---

<section class="border-t border-base-200 border-dotted">
  <Wrapper variant="standard" class="py-4 bg-dots-light">
    <div
      class="p-8 pt-32 lg:pt-48 grid grid-cols-1 lg:grid-cols-3 lg:items-end bg-linear-45 from-accent-600"
    >
      <div class="text-balance lg:col-span-2 lg:w-2/3">
        <Text tag="h2" variant="displayMD" class="font-medium text-white">
          Ready to get started?
        </Text>
        <Text tag="p" variant="textBase" class="mt-2 text-white/90">
          Jump right in with our quick start guide or explore the full
          documentation.
        </Text>
      </div>

      <Button
        isLink={true}
        size="sm"
        variant="muted"
        href="/docs/getting-started/introduction"
        class="w-fit lg:ml-auto"
      >
        Start Reading
      </Button>
    </div>
  </Wrapper>
</section>
