---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-32">
    <div class="text-center text-balance">
      <Text
        tag="h1"
        variant="displayLG"
        class="font-medium tracking-tight text-black"
      >
        Developer documentation portal
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="max-w-xl mx-auto mt2 text-base-500"
      >
        Your complete resource for guides, API references, and integration
        support
      </Text>
    </div>
    <div
      class="flex flex-wrap items-center justify-center w-full mt-10 just gap-2"
    >
      <Button
        isLink={true}
        size="sm"
        variant="accent"
        href="/docs/getting-started/introduction">Get started</Button
      >
      <Button isLink={true} size="sm" variant="muted" href="/docs/api/overview"
        >Start free trial</Button
      >
    </div>
  </Wrapper>
</section>
