---
import Text from "@/components/fundations/elements/Text.astro";
// Icons
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";

const resources = [
  {
    id: "support",
    title: "Support",
    description: "Browse our FAQs or get direct help from our support team.",
    href: "/docs/help/faq",
  },
  {
    id: "community",
    title: "Community",
    description:
      "Join our Discord and forums to connect with other developers.",
    href: "#_",
  },
  {
    id: "tutorials",
    title: "Tutorials",
    description:
      "Hands-on tutorials to guide you through core features and patterns.",
    href: "/blog/",
  },
  {
    id: "integrations",
    title: "Integrations",
    description: "Explore popular tools and third-party integrations.",
    href: "/integrations",
  },
];
---

<section>
  <div class="px-8 py-12">
    <div class="max-w-2xl">
      <Text
        tag="h2"
        id="resources-heading"
        variant="textLG"
        class="font-medium text-base-900 mt-auto dark:text-white"
      >
        Resources
      </Text>
      <Text
        tag="p"
        variant="textSM"
        class="mt-4 text-base-500 dark:text-base-300 leading-6 text-balance"
      >
        Find the help you need to succeed with your project — from support and
        tutorials to community and third-party integrations.
      </Text>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2 mt-12">
      {
        resources.map((item) => (
          <div class="flex flex-col  justify-between h-full p-4 bg-base-50 rounded-xl dark:bg-base-800 gap-12 ">
            <div>
              <Text
                tag="h3"
                variant="textBase"
                class="font-medium text-base-900 dark:text-white"
              >
                {item.title}
              </Text>
              <Text tag="p" variant="textSM" class="mt-2 text-base-500">
                {item.description}
              </Text>
            </div>
            <a
              href={item.href}
              class=" text-sm text-accent-600 hover:text-base-900 dark:text-accent-400 items-center gap-2 flex group"
              aria-label={`${item.title}: ${item.description}`}
            >
              Explore
              <ChevronRight
                size="sm"
                class="group-hover:translate-x-2 duration-300"
              />
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
