---
// Components
import SearchBar from "@/components/global/navigation/SearchBar.astro";
import ThemeToggle from "@/components/assets/ThemeToggle.astro";
const navigationButtons = [
  {
    title: "Overview",
    href: "/system/overview",
  },
  {
    title: "Blog",
    href: "/blog/home",
  },
];
---

<header
  class="hidden lg:block fixed top-0 right-0 left-72 w-auto bg-white z-50 dark:bg-base-900 border-b border-base-200 dark:border-base-800 px-4 py-2.5"
>
  <div class="flex items-center justify-between gap-4">
    <div class="w-full max-w-48">
      <SearchBar searchId="desktop" />
    </div>
    <div class="flex flex-col ml-auto gap-2 md:gap-4 md:flex-row">
      {
        navigationButtons.map((Button, index) => (
          <a
            href={Button.href}
            class="text-2xl  md:text-sm hover:text-base-600 text-base-500"
          >
            {Button.title}
          </a>
        ))
      }
    </div>
    <ThemeToggle />
  </div>
</header>
