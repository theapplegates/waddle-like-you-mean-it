---
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
// Assets
import Logo from "@/components/assets/Logo.astro";
// Components
import SidebarLinks from "@/components/global/navigation/SidebarLinks.astro";
// Scripts
import MobileMenuScript from "@/components/fundations/scripts/MobileMenuScript.astro";
// Icons
import RoundedX  from "@/components/fundations/icons/CircleCheck.astro";
// Get all docs and group by category
import { getCollection } from "astro:content";
const allDocs = await getCollection("docs");
const groupedDocs = allDocs.reduce(
  (acc, doc) => {
    const category = doc.data.category;
    if (!acc[category]) {
      acc[category] = [];
    }
    acc[category].push({
      slug: doc.slug,
      title: doc.data.title,
      order: doc.data.order || 999,
    });
    return acc;
  },
  {} as Record<string, Array<{ slug: string; title: string; order: number }>>
);
// Sort docs within each category by order
Object.keys(groupedDocs).forEach((category) => {
  groupedDocs[category].sort((a, b) => a.order - b.order);
});
// Define category display names and order
const categoryConfig = {
  "getting-started": { name: "Getting Started", order: 1 },
  guides: { name: "Guides", order: 2 },
  api: { name: "API Reference", order: 3 },
  examples: { name: "Examples", order: 4 },
  help: { name: "Help & Support", order: 5 },
};
const sortedCategories = Object.keys(groupedDocs).sort((a, b) => {
  const orderA = categoryConfig[a]?.order || 999;
  const orderB = categoryConfig[b]?.order || 999;
  return orderA - orderB;
});
---

<!-- Sidebar backdrop for mobile -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-40 hidden bg-base-900/50 lg:hidden"
>
</div>
<!-- Sidebar -->
<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-50 bg-white border-r w-72 dark:bg-base-900 border-base-200 dark:border-base-800 transform -translate-x-full transition-transform duration-300 ease-in-out lg:translate-x-0"
>
  <div class="flex flex-col h-full">
    <!-- Logo/Title -->
    <div class="flex items-center justify-between px-8 h-14">
      <a
        href="/"
        class="flex items-center space-x-2 text-base-900 dark:text-white"
      >
        <Logo class="size-4 text-accent-600 dark:text-accent-400" />
        <span class="font-semibold text-lg">ZeroIndex</span>
      </a>
      <!-- Close button for mobile -->
      <button
        id="sidebar-close"
        class="p-2 lg:hidden rounded-md text-base-400 hover:text-base-500 hover:bg-base-200"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="flex-1 px-4 py-6 overflow-y-auto">
      {
        sortedCategories.map((categoryKey, index) => {
          const category = categoryConfig[categoryKey];
          const docs = groupedDocs[categoryKey];
          return (
            <SidebarLinks
              title={category?.name || categoryKey}
              docs={docs}
              index={index}
            />
          );
        })
      }
    </nav>
    <!-- Footer -->
    <div
      class="px-6 py-4 border-t border-base-200 dark:border-base-800 relative"
    >
      <Button isLink={true} size="sm" variant="muted" href="#_">
        Buy ZeroIndex
      </Button>
    </div>
  </div>
</aside>
<MobileMenuScript />

