---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
// Icons
import Close from "@/components/fundations/icons/Close.astro";
import Error from "@/components/fundations/icons/Error.astro";
import Warning from "@/components/fundations/icons/Warning.astro";
import Info from "@/components/fundations/icons/RoundedInfo.astro";
import Resources from "@/components/fundations/icons/Resources.astro";
import Success from "@/components/fundations/icons/RoundedCheck.astro";
const {
  icon: customIcon = null,
  variant = "warning",
  title = "",
  description = "",
  list = [],
  links = [],
  dismissible = false,
  role = "alert",
} = Astro.props;
// Define variant styles with default icons
const variants = {
  warning: {
    bg: "bg-orange-50/50 dark:bg-orange-600/5",
    iconColor: "text-orange-500 dark:text-orange-300",
    titleColor: "text-orange-500 dark:text-orange-300",
    textColor: "text-base-600 dark:text-base-400",
    linkColor:
      "text-base-900 dark:text-white hover:text-orange-500 dark:hover:text-orange-300",
    outlineColor: "outline-orange-100 dark:outline-orange-500/10 ",
    defaultIcon: Warning,
  },
  error: {
    bg: "bg-rose-50/50 dark:bg-rose-600/5",
    iconColor: "text-rose-500 dark:text-rose-300",
    titleColor: "text-rose-500 dark:text-rose-300",
    textColor: "text-base-600 dark:text-base-400",
    linkColor:
      "text-base-900 dark:text-white hover:text-rose-500 dark:hover:text-rose-300",
    outlineColor: "outline-rose-100 dark:outline-rose-500/10 ",
    defaultIcon: Error,
  },
  info: {
    bg: "bg-indigo-50/50 dark:bg-indigo-600/5",
    iconColor: "text-indigo-500 dark:text-indigo-300",
    titleColor: "text-indigo-500 dark:text-indigo-300",
    textColor: "text-base-600 dark:text-base-400",
    linkColor:
      "text-base-900 dark:text-white hover:text-indigo-500 dark:hover:text-indigo-300",
    outlineColor: "outline-indigo-100 dark:outline-indigo-500/15 ",
    defaultIcon: Info,
  },
  success: {
    bg: "bg-emerald-50/50 dark:bg-emerald-600/5",
    iconColor: "text-emerald-500 dark:text-emerald-300",
    titleColor: "text-emerald-500 dark:text-emerald-300",
    textColor: "text-base-600 dark:text-base-400",
    linkColor:
      "text-base-900 dark:text-white hover:text-emerald-500 dark:hover:text-emerald-300 ",
    outlineColor: "outline-emerald-100 dark:outline-emerald-500/15 ",
    defaultIcon: Success,
  },
  neutral: {
    bg: "bg-base-50/50 dark:bg-base-600/5",
    iconColor: "text-base-500 dark:text-emerald-300",
    titleColor: "text-base-500 dark:text-base-300",
    textColor: "text-base-600 dark:text-base-400",
    linkColor:
      "text-base-900 dark:text-white hover:text-base-600 dark:hover:text-base-300",
    outlineColor: "outline-base-100 dark:outline-base-500/15 ",
    defaultIcon: Resources,
  },
};
const currentVariant = variants[variant] || variants.warning;
const Icon = customIcon || currentVariant.defaultIcon;
---

<div
  class={`rounded-xl outline p-4 relative ${currentVariant.bg} ${currentVariant.outlineColor}`}
  role={role}
  aria-live={variant === "error" ? "assertive" : "polite"}
>
  <div class="flex items-start">
    {
      Icon && (
        <div class="shrink-0">
          <Icon
            size="sm"
            aria-hidden="true"
            class={` ${currentVariant.iconColor}`}
          />
        </div>
      )
    }
    <div class={Icon ? "ml-3" : ""}>
      {
        title && (
          <Text
            tag="h3"
            variant="textBase"
            class={` -mt-1 font-medium ${currentVariant.titleColor}`}
          >
            {title}
          </Text>
        )
      }
      {
        description && (
          <Text
            tag="h3"
            variant="textSM"
            class={`mt-2 ${currentVariant.textColor}`}
          >
            {description}
          </Text>
        )
      }
      {
        list.length > 0 && (
          <ul
            class={`mt-2 list-disc list-inside text-sm ${currentVariant.textColor}`}
          >
            {list.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
      {
        links.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-4 text-sm">
            {links.map((link) => (
              <a
                href={link.href}
                class={`underline ${currentVariant.linkColor} focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 rounded`}
              >
                {link.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
    {
      dismissible && (
        <div class="ml-auto pl-3">
          <button
            type="button"
            class={`inline-flex rounded-md p-1.5 ${currentVariant.iconColor} hover:bg-black/5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500`}
            aria-label="Dismiss alert"
            onclick="this.closest('[role=alert]').remove()"
          >
            <Close slot="icon" size="sm" />
          </button>
        </div>
      )
    }
  </div>
</div>
