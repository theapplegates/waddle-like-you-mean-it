---
import Logo from "@/components/assets/Logo.astro";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";

// Icons
import GitHub from "@/components/fundations/icons/GitHub.astro";
import GoogleColor from "@/components/fundations/icons/GoogleColor.astro";
---

<BaseLayout hideNav={true} hideFooter={true}>
  <section>
    <div class="p-8 bg-dots-light flex flex-col items-center h-svh">
      <div
        class="bg-white py-12 w-full px-8 h-full flex flex-col items-center justify-center"
      >
        <div class="w-full max-w-md mx-auto">
          <div>
            <a href="/">
              <span class="sr-only">Back to home</span>
              <Logo class="h-8 text-base-900" />
            </a>
            <Text
              tag="h1"
              variant="displayMD"
              class="text-accent-950 font-medium mt-12"
            >
              Sign in
            </Text>
          </div>
          <form class="mt-10 space-y-4">
            <div class="w-full">
              <div class="flex items-baseline justify-between mb-1">
                <label for="email" class="text-sm font-medium text-base-500"
                  >Email Address</label
                >
              </div>
              <div class="relative z-0 focus-within:z-10">
                <input
                  id="email"
                  name="email"
                  type="email"
                  class="block w-full px-4 py-2 text-xs leading-tight align-middle bg-white border border-transparent transition duration-300 ease-in-out focus:z-10 h-9 rounded-md text-base-500 ring-1 ring-base-200 placeholder-base-400 focus:border-accent-500 focus:ring-accent-100 focus:ring-2 focus:outline-none shadow-sm"
                  inputmode="email"
                />
              </div>
            </div>
            <div class="w-full">
              <div class="flex items-baseline justify-between mb-1">
                <label for="password" class="text-sm font-medium text-base-500"
                  >Password</label
                >
              </div>
              <div class="relative z-0 focus-within:z-10">
                <input
                  required
                  id="password"
                  name="password"
                  class="block w-full px-4 py-2 text-xs leading-tight align-middle bg-white border border-transparent transition duration-300 ease-in-out focus:z-10 h-9 rounded-md text-base-500 ring-1 ring-base-200 placeholder-base-400 focus:border-accent-500 focus:ring-accent-100 focus:ring-2 focus:outline-none shadow-sm"
                  aria-required="true"
                />
              </div>
            </div>
            <div class="flex items-center">
              <input
                type="checkbox"
                id="login-remember"
                name="login-remember"
                class="rounded shadow border-base-300 text-accent-600 focus:ring-accent-500 focus:ring-offset-2 focus:ring-2 size-4"
              />
              <label
                for="login-remember"
                class="ml-2 text-sm font-medium text-base-500"
              >
                Remember me for 30 days
              </label>
            </div>
            <div class="flex flex-wrap gap-2 items-center">
              <Button
                size="base"
                variant="accent"
                gap="sm"
                type="submit"
                class="w-fit"
              >
                Sign in with email
              </Button>
              <span class="lg:mx-4 text-sm text-base-500">Or use</span>
              <Button iconOnly size="sm" variant="muted" type="submit">
                <GoogleColor slot="icon" size="base" />
              </Button>
              <Button iconOnly size="sm" variant="muted" type="submit">
                <GitHub slot="icon" size="base" />
                Sign in with Google
              </Button>
            </div>
          </form>
          <p class="mt-4 text-xs font-medium text-base-500">
            Dont' have an account?
            <a
              href="/forms/sign-up"
              class="font-medium text-accent-500 hover:text-base-500"
            >
              Sign up
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
