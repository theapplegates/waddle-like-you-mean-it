---
// Fundations
import DocsLayout from "@/layouts/DocsLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import CircleCheck from "@/components/fundations/icons/CircleCheck.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import ArrowDownright from "@/components/fundations/icons/ArrowDownright.astro";
// Scripts
import AskGPT from "@/components/fundations/scripts/AskGPT.astro";
import AskClaude from "@/components/fundations/scripts/AskClaude.astro";
import CopyAsMarkdown from "@/components/fundations/scripts/CopyAsMarkdown.astro";
import CopyToClipboard from "@/components/fundations/scripts/CopyToClipboard.astro";
import TocAnimationScript from "@/components/fundations/scripts/TocAnimationScript.astro";
import DocsFeedbackButton from "@/components/fundations/scripts/DocsFeedbackButton.astro";
// Content
import { type CollectionEntry, getCollection } from "astro:content";
export async function getStaticPaths() {
  const docs = await getCollection("docs");
  // Sort docs by order within each category
  const sortedDocs = docs.sort((a, b) => {
    if (a.data.category === b.data.category) {
      return a.data.order - b.data.order;
    }
    return a.data.category.localeCompare(b.data.category);
  });
  return sortedDocs.map((doc, index) => {
    const prevDoc = index > 0 ? sortedDocs[index - 1] : null;
    const nextDoc =
      index < sortedDocs.length - 1 ? sortedDocs[index + 1] : null;
    return {
      params: { slug: doc.slug },
      props: {
        doc,
        prevDoc,
        nextDoc,
      },
    };
  });
}
type Props = {
  doc: CollectionEntry<"docs">;
  prevDoc: CollectionEntry<"docs"> | null;
  nextDoc: CollectionEntry<"docs"> | null;
};
const { doc, prevDoc, nextDoc } = Astro.props;
const { Content, headings } = await doc.render();
// Format the date
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
};
---

<DocsLayout title={doc.data.title} description={doc.data.description}>
  <!-- Document header -->
  <div
    class="flex flex-col lg:flex-row lg:divide-x lg:divide-base-200 dark:divide-base-800"
  >
    <div class="flex-1 max-w-4xl">
      <header class="p-4 relative bg-dots-light dark:bg-dots-dark">
        <div
          class="flex flex-col justify-between h-full gap-24 lg:gap-48 relative p-4 bg-white dark:bg-base-900"
        >
          <div>
            <div
              class="flex items-center text-xs gap-1 text-base-500 dark:text-base-300"
            >
              <a href="/" class="hover:text-accent-600">Home</a>
              <ChevronRight size="xs" />
              <span class="capitalize"
                >{doc.data.category.replace("-", " ")}</span
              >
              <ChevronRight size="xs" />
              <span class="text-accent-500 dark:text-accent-400"
                >{doc.data.title}</span
              >
            </div>
            <Text
              tag="p"
              variant="textXS"
              class="mt-1 font-mono font-medium text-base-400 flex items-center gap-2"
            >
              <ArrowDownright size="sm" />
              Last updated: {formatDate(doc.data.lastUpdated)}
            </Text>
          </div>
          <div>
            <Text
              tag="h1"
              variant="displaySM"
              class="font-meidum text-base-900 dark:text-white"
            >
              {doc.data.title}
            </Text>
            <Text
              tag="p"
              variant="textSM"
              class="text-base-500 dark:text-base-400"
              >{doc.data.description}</Text
            >
          </div>
        </div>
      </header>
      <!-- Main content -->

      <div id="markdown-content">
        <Wrapper variant="prose" class="px-8 py-4">
          <Content />
        </Wrapper>
      </div>
      <div
        class="flex px-8 py-4 gap-2 border-t border-base-200 dark:border-base-800"
      >
        <Button id="copy-markdown" size="xxs" variant="muted">
          Copy page as Markdown for LLMs
        </Button>
        <Button id="ask-chatgpt" size="xxs" variant="muted">
          Ask ChatGPTø
        </Button>
        <Button id="ask-claude" size="xxs" variant="muted"> Ask Claude </Button>
      </div>
      <div
        class="grid grid-cols-1 lg:grid-cols-2 items-center px-8 py-4 gap-y-12 lg:h-16 border-t border-base-200 dark:border-base-800"
      >
        <div class="text-sm text-base-500">
          Found an issue with this page?
          <a href="#_" class="text-accent-600 hover:text-accent-700"
            >Edit on GitHub</a
          >
        </div>
        <div class="ml-auto">
          <div id="feedback-buttons" class="flex gap-2 items-center ml-auto">
            <span class="text-sm text-base-500 dark:text-base-400">
              Was this helpful?</span
            >
            <Button size="xxs" variant="muted" id="yes-btn"> Yes </Button>
            <Button size="xxs" variant="muted" id="no-btn"> No </Button>
          </div>
          <span id="thank-you" class="hidden">
            <div class="duration-300 flex justify-center md:justify-start">
              <div
                class="flex items-center gap-3 rounded-full bg-emerald-50/50 py-1 pr-3 pl-1.5 text-sm text-emerald-900 ring-1 ring-emerald-500/20 ring-inset dark:bg-emerald-500/5 dark:text-emerald-200 dark:ring-emerald-500/30"
              >
                <CircleCheck
                  size="sm"
                  class="size-6 flex-none fill-emerald-500 stroke-white dark:fill-emerald-200/20 dark:stroke-emerald-200"
                />
                Thanks for your feedback!
              </div>
            </div>
          </span>
        </div>
      </div>
    </div>
    <aside
      class="hidden lg:block w-64 lg:sticky lg:top-14 p-4 pl-0 h-full lg:self-start"
    >
      <Text
        tag="h4"
        variant="textSM"
        class="text ml-4 text-base-900 dark:text-white">On this page</Text
      >
      <div class="mt-4">
        {
          headings
            .filter((h) => h.depth === 2 || h.depth === 3)
            .map((heading) => (
              <a
                href={`#${heading.slug}`}
                class="block hover:text-accent-600 py-1 text-base-500 dark:text-base-400 text-xs select-none  border-l-2 border-transparent transition-all duration-200 toc-link"
                style={`padding-left: ${heading.depth === 3 ? "1.8rem" : "1rem"}`}
                data-heading-id={heading.slug}
                data-heading-depth={heading.depth}
              >
                {heading.text}
              </a>
            ))
        }
      </div>
    </aside>
  </div>
  <nav
    aria-label="Documentation pagination"
    class="w-full grid grid-cols-1 md:grid-cols-2 divide-y divide-base-200 dark:divide-base-800 lg:divide-y-0 lg:divide-x border-t border-base-200 dark:border-base-800"
  >
    <div class="w-full">
      {
        prevDoc && (
          <a
            href={`/docs/${prevDoc.slug}`}
            class="flex flex-col w-full gap-12 p-8 group  hover:bg-base-50 dark:hover:bg-base-800 duration-200"
          >
            <span class="text-xs font-medium tracking-wide uppercase text-base-500 dark:text-base-400 font-mon">
              Previous
            </span>
            <div>
              <div class="text-sm font-medium truncate text-base-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
                {prevDoc.data.title}
              </div>
              <div class="text-xs capitalize text-base-500 dark:text-base-400">
                {prevDoc.data.category.replace("-", " ")}
              </div>
            </div>
          </a>
        )
      }
    </div>
    <div class="w-full">
      {
        nextDoc && (
          <a
            href={`/docs/${nextDoc.slug}`}
            class="flex flex-col gap-12 justify-end w-full p-8  group  hover:bg-base-50 dark:hover:bg-base-800 duration-200"
          >
            <span class="text-xs font-medium tracking-wide uppercase text-base-500 dark:text-base-400 font-mono">
              Next
            </span>
            <div>
              <div class="text-sm font-medium truncate text-base-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
                {nextDoc.data.title}
              </div>
              <div class="text-xs capitalize text-base-500 dark:text-base-400">
                {nextDoc.data.category.replace("-", " ")}
              </div>
            </div>
          </a>
        )
      }
    </div>
  </nav>
</DocsLayout>
<TocAnimationScript />
<DocsFeedbackButton />
<CopyToClipboard />
<AskGPT />
<AskClaude />
<CopyAsMarkdown />
