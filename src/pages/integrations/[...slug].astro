---
import { getCollection } from "astro:content";
import IntegrationsLayout from "@/layouts/IntegrationsLayout.astro";

// Step 1: getStaticPaths
export async function getStaticPaths() {
  const allIntegrations = await getCollection("integrations");

  // You can optionally filter or sort here, depending on your needs
  const sorted = allIntegrations.sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );

  return sorted.map((page) => ({
    params: { slug: page.slug },
    props: { slug: page.slug },
    trailingSlash: false,
  }));
}

// Step 2: Load content + find previous/next
const { slug } = Astro.props;

const allIntegrations = await getCollection("integrations");
const sorted = allIntegrations.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const index = sorted.findIndex((item) => item.slug === slug);
const page = sorted[index];
const previous = sorted[index - 1] || null;
const next = sorted[index + 1] || null;

const { Content } = await page.render();
---

<IntegrationsLayout frontmatter={page.data} previous={previous} next={next}>
  <Content />
</IntegrationsLayout>
