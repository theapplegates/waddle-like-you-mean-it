---
import { getCollection } from "astro:content";
import InfoPagesLayout from "../../layouts/InfoPagesLayout.astro";

export async function getStaticPaths() {
  const allPages = await getCollection("infopages");

  const sorted = allPages.sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );

  return sorted.map((page) => ({
    params: { slug: page.slug },
    props: { slug: page.slug },
    trailingSlash: false,
  }));
}

const { slug } = Astro.props;

const allPages = await getCollection("infopages");

const sorted = allPages.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const index = sorted.findIndex((item) => item.slug === slug);
const page = sorted[index];
const previous = sorted[index - 1] || null;
const next = sorted[index + 1] || null;

// ✅ Extract both Content and headings
const { Content, headings } = await page.render();
---

<InfoPagesLayout
  frontmatter={page.data}
  previous={previous}
  next={next}
  headings={headings}
>
  <Content />
</InfoPagesLayout>
